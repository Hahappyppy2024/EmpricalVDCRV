{
  "name": "research/p07-cloud-file-sharing-system",
  "description": "Offline multi-role cloud file sharing workflow application",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": "8.3.*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "slim/slim": "4.15.2",
    "slim/psr7": "1.8.0"
  },
  "autoload": {"psr-4": {"App\\": "src/", "Tests\\": "tests/"}},
  "scripts": {
    "db:reset": "php bin/reset-database.php",
    "functional:test": "php bin/run-functional-tests.php",
    "start": "php -S 0.0.0.0:8080 -t public public/router.php"
  },
  "config": {"sort-packages": true, "platform": {"php": "8.3.0"}, "allow-plugins": {}},
  "prefer-stable": true,
  "minimum-stability": "stable"
}
