# P14 Workflow Automation / Agentic Task Platform — local configuration
# Copy to .env and adjust as needed. All variables are optional; defaults are shown.

# HTTP listen address
APP_ADDR=:8080

# SQLite database file
DB_PATH=./data/p14.db

# Working/data directory (used for the SQLite file)
DATA_DIR=./data

# Server-side session cookie name (HttpOnly)
SESSION_COOKIE=p14_session

# Session lifetime in seconds (default 24h)
SESSION_TTL_SECONDS=86400

# Public base URL used to build webhook trigger URLs and echo URLs in seeds
WEB_BASE_URL=http://localhost:8080

# Set to "true" to reset the database and load deterministic seed fixtures on startup
SEED_DB=false

# Uploaded workspace file size limit in bytes (default 5 MiB)
MAX_FILE_BYTES=5242880

# Max JSON request body size in bytes (default 1 MiB)
MAX_PAYLOAD_BYTES=1048576

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Simulated step delay used by the deterministic execution engine (ms)
STEP_DELAY_MS=120

# Scheduler polling interval (ms)
SCHEDULER_TICK_MS=20000
