# Real-Time Team Chat System - environment configuration
# Copy this file to `.env` and adjust as needed.
# Every variable has a safe local default, so the app runs without a `.env`.

# Secret used to sign cookies and deterministic tokens. Change in production.
SECRET_KEY=dev-secret-change-me

# SQLAlchemy database URL. Relative SQLite paths resolve against app.instance_path
# (the instance/ folder inside the project). Use an absolute sqlite:////path URL
# to point elsewhere.
DATABASE_URL=sqlite:///chat.db

# Name of the HTTP-only session cookie.
SESSION_COOKIE_NAME=chat_session

# Server-side session lifetime in seconds (default: 7 days).
SESSION_TTL_SECONDS=604800

# Local folder where uploaded files are stored.
UPLOAD_FOLDER=instance/uploads

# Maximum accepted upload size in bytes (default: 16 MiB).
MAX_UPLOAD_BYTES=16777216

# Local folder where the deterministic mail adapter writes sent mail.
MAILBOX_DIR=instance/mailbox

# Base URL used when building absolute links (reset links, invitation links).
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Whether the session cookie requires HTTPS (set true behind TLS).
COOKIE_SECURE=false
