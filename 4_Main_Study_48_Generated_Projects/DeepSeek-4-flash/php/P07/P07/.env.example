# Cloud File-Sharing System environment configuration.
# Copy this file to `.env` and adjust values for local execution.

# Application
APP_NAME="Cloud File-Sharing System"
APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=UTC

# Web server: address and port used by `composer start` / `php -S`
APP_HOST=127.0.0.1
APP_PORT=8080

# SQLite database file (absolute or project-relative path)
DB_PATH=storage/db/cloudfs.sqlite

# Storage directory for uploaded file blobs
STORAGE_PATH=storage/files

# Cookie / session configuration
SESSION_COOKIE_NAME=cfss_session
SESSION_LIFETIME_SECONDS=7200

# Real-time (WebSocket) server via Workerman
WS_HOST=127.0.0.1
WS_PORT=8282

# Default quota for new users (bytes). 104857600 = 100 MiB
DEFAULT_QUOTA_BYTES=104857600

# Default retention policies
TRASH_RETENTION_DAYS=30
VERSION_RETENTION_COUNT=10
