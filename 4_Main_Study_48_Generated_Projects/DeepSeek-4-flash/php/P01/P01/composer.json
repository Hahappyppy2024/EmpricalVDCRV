{
    "name": "emse/p01-learning-management-system",
    "description": "P01 Learning Management System - synthetic benchmark project aligned with the Moodle ecosystem",
    "type": "project",
    "license": "MIT",
    "keywords": ["lms", "learning", "slim", "php"],
    "require": {
        "php": "^8.3",
        "slim/slim": "4.15.2",
        "slim/psr7": "1.8.0",
        "workerman/workerman": "4.1.17"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform-check": false
    },
    "scripts": {
        "db:reset": "php bin/reset.php",
        "serve": "php -S 127.0.0.1:8080 -t public",
        "ws": "php bin/websocket.php start"
    }
}
