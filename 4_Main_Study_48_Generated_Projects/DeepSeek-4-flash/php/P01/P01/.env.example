# Copy this file to `.env` and adjust the values for your local machine.

# Application environment: local | production
APP_ENV=local

# Base URL used to build absolute links in e-mails and pages
BASE_URL=http://localhost:8080

# Relative (to project root) or absolute path to the SQLite database file
DB_PATH=data/lms.sqlite

# Directory that stores uploaded course material and submission files
UPLOAD_DIR=data/uploads

# Directory that stores generated grade export / report files
EXPORT_DIR=data/exports

# Server-side session lifetime in minutes (sessions are persisted in SQLite)
SESSION_LIFETIME_MINUTES=480

# Allow public visitor registration (login as student)
ALLOW_REGISTRATION=true

# Workerman WebSocket server host/port used for real-time announcements/discussion
WS_HOST=127.0.0.1
WS_PORT=8280

# Site name shown in the UI
SITE_NAME=P01 Learning Management System
