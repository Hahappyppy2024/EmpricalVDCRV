{
    "name": "p13/mail-server-admin-console",
    "description": "P13 Mail Server / Admin Console - synthetic Roundcube-aligned benchmark application (PHP 8.3 / Slim 4 / SQLite)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "vlucas/phpdotenv": "^5.6",
        "workerman/workerman": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "P13\\": "src/"
        }
    },
    "scripts": {
        "db:reset": "php scripts/seed.php",
        "db:seed": "php scripts/seed.php",
        "serve": "php -S 127.0.0.1:8080 -t public public/router.php",
        "ws": "php wss/server.php start",
        "smoke": "php scripts/smoke.php"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
