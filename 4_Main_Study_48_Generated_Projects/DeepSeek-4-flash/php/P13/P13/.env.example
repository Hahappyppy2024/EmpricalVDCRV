# P13 Mail Server / Admin Console — environment configuration
# Copy to .env and adjust as needed. All values below are local defaults.

# Public URL of the application
APP_URL=http://127.0.0.1:8080

# Show debug details in 500 responses (false for production-like behavior)
APP_DEBUG=false

# SQLite database file (relative to the project root or absolute)
DATABASE_PATH=./data/p13.sqlite

# Local file storage root (attachments + import/export files)
STORAGE_PATH=./storage

# HTTP-only session cookie name
SESSION_COOKIE_NAME=p13_session

# Session lifetime in seconds
SESSION_TTL_SECONDS=86400

# Maximum upload size in megabytes (attachments / imports)
MAX_UPLOAD_MB=10

# WebSocket URL advertised to the browser (optional real-time transport)
WS_URL=ws://127.0.0.1:8090

# WebSocket process listen port
WS_PORT=8090

# Password used for every deterministic seed account
SEED_PASSWORD=Passw0rd!
