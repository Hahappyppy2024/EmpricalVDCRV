# P16 - Server Monitoring & Job Control Panel - environment configuration
# Copy to .env and adjust for local execution. All values have local defaults.

# Application URL (used for links / redirects in development)
APP_URL=http://127.0.0.1:8080

# Environment: development | production
APP_ENV=development

# Secret used for signing / generic app security (change in production)
APP_SECRET=p16-local-dev-secret-change-me

# SQLite database file path
DB_PATH=storage/monitoring.sqlite

# Session cookie name and lifetime (seconds)
SESSION_NAME=p16_session
SESSION_LIFETIME=7200

# Workerman WebSocket push server (optional real-time metrics)
WS_ENABLED=0
WS_URL=ws://127.0.0.1:9090
WS_PORT=9090

# Storage directories for backups, uploads and mirrored log files
BACKUP_DIR=storage/backups
UPLOAD_DIR=storage/uploads
LOG_DIR=storage/logs
