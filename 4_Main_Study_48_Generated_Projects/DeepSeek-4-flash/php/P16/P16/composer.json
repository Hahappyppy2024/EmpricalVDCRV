{
    "name": "synthetic/p16-server-monitoring",
    "description": "P16 - Server Monitoring & Job Control Panel (synthetic benchmark project, Slim 4 + SQLite)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "slim/slim": "4.15.2",
        "slim/psr7": "1.8.0",
        "vlucas/phpdotenv": "5.6.1",
        "workerman/workerman": "4.1.17"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
