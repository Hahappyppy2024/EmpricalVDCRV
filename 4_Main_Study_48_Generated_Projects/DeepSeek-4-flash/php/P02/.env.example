# P02 Conference Review System — environment configuration
# Copy to `.env` and adjust if needed. All values below are valid for local execution.

# Application
APP_NAME="Conference Review System"
APP_ENV=local
APP_URL=http://127.0.0.1:8080

# Database (SQLite)
# Relative path is resolved from the project root.
DB_PATH=database/conference.sqlite

# Sessions (server-side sessions stored in SQLite, HTTP-only cookie)
SESSION_NAME=conf_session
SESSION_LIFETIME=86400

# Storage (uploaded manuscripts, exports, logs)
STORAGE_PATH=storage
MAIL_TO_FILE=storage/mail.log
ERROR_LOG=storage/errors.log

# Real-time WebSocket (Workerman) — local process sharing the same SQLite DB
WS_PORT=8090
WS_URL=ws://127.0.0.1:8090

# Signing key for local token derivation (change in production)
APP_KEY=local-dev-key
