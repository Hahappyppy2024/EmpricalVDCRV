# P03 E-commerce System - environment configuration
# Copy to .env and adjust values for local execution.

# SQLite database file path (relative paths resolve from the project root).
DB_PATH=data/shop.db

# Web application host and port (built-in PHP dev server).
APP_HOST=0.0.0.0
APP_PORT=8080
APP_URL=http://localhost:8080

# Real-time WebSocket endpoint (Workerman process) - used by SHOP-13.
WS_HOST=127.0.0.1
WS_PORT=8081
WS_URL=ws://127.0.0.1:8081

# Upload directory for product images (relative to project root).
UPLOAD_DIR=public/uploads

# Log file for runtime errors.
LOG_FILE=storage/logs/error.log

# Production flag: false keeps deterministic local behavior.
APP_ENV=local
