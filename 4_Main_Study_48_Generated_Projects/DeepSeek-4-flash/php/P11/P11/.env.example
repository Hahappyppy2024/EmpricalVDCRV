# P11 Hosting Control Panel - local configuration
# Copy this file to .env and adjust values as needed.

# SQLite database file path
DB_PATH=data/hosting.db

# Storage directory for files, backups and restore logs
STORAGE_DIR=storage

# Session lifetime in seconds (HTTP-only cookie)
SESSION_LIFETIME=86400

# Public URL used for links
APP_URL=http://localhost:8080

# Dev server host/port (used by bin/serve.php)
HOST=0.0.0.0
PORT=8080

# Workerman WebSocket port (real-time audit feed, optional)
WS_PORT=8081
