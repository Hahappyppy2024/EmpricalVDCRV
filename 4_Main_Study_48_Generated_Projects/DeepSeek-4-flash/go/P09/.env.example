# P09 Issue Tracking System — environment configuration
# Copy to .env and adjust, or export these variables directly.
# All variables have documented local defaults; the application runs fully
# offline with the defaults.

# HTTP listen port
PORT=8080

# SQLite database file path (created automatically)
DB_PATH=data/issuetracker.db

# Directory for uploaded/stored files
UPLOAD_DIR=data/uploads

# Secret used for session cookie signing/session tokens (change in production)
SESSION_SECRET=dev-only-secret-change-me

# Session lifetime in hours
SESSION_TTL_HOURS=24

# Maximum upload size in megabytes (attachments and import files)
MAX_UPLOAD_MB=5

# Public base URL; used for seeded webhook URLs and links
APP_URL=http://localhost:8080
