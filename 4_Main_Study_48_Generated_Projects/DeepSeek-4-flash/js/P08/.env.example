# Server
PORT=3000
HOST=0.0.0.0

# Database
DB_PATH=./data/app.db

# Storage
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# Session
SESSION_COOKIE_NAME=exp_session
SESSION_TTL_HOURS=8

# File upload limits
MAX_UPLOAD_BYTES=5242880
ALLOWED_UPLOAD_MIME_TYPES=image/png,image/jpeg,application/pdf,text/plain

# WebSocket
WS_PATH=/ws
