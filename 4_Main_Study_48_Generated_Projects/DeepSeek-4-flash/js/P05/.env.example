# P05 Content Management System - local configuration
# Copy to .env and adjust values as needed. All values below are local-safe defaults.

# HTTP server
PORT=3000
HOST=0.0.0.0

# Application mode: development | production
NODE_ENV=development

# SQLite database file (path is resolved relative to the project root)
DB_PATH=./data/cms.db

# Local file storage directories
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports

# Session lifetime in days
SESSION_TTL_DAYS=7

# Maximum media upload size in megabytes
MAX_UPLOAD_MB=10

# Public base URL used when building absolute links
PUBLIC_BASE_URL=http://localhost:3000
