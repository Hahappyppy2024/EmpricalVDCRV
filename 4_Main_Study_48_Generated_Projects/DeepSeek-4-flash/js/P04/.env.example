# Server
PORT=3000
HOST=0.0.0.0

# Public base URL (used for absolute links in generated emails and exports)
PUBLIC_BASE_URL=http://localhost:3000

# Node environment: development | production
# In development the deterministic email adapter keeps a full copy of every
# dispatched message in the outbox so flows like password recovery can be
# exercised offline without a mail server.
NODE_ENV=development

# Session lifetime in minutes (default 480 = 8 hours)
SESSION_TTL_MINUTES=480

# Database file location. data/ is gitignored and recreated by `npm run reset`.
DB_PATH=./data/hotel.db
