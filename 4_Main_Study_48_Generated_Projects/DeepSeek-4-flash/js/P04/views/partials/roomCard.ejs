<div class="card">
  <div class="room-media">
    <% if (room.image_url) { %>
      <img src="<%= room.image_url %>" alt="<%= room.name %>" style="width:100%;height:100%;object-fit:cover;border-radius:8px;">
    <% } else { %>
      <div style="background:#dde6f5;width:100%;height:100%;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#66758a;"><%= room.name %></div>
    <% } %>
  </div>
  <div class="flex-between">
    <h3 style="margin:0;"><a href="/rooms/<%= room.id %>"><%= room.name %></a></h3>
    <span class="money" style="color:var(--primary);">$<%= room.price_per_night %>/night</span>
  </div>
  <p class="muted mb-2" style="font-size:13px;"><%= room.description %></p>
  <div class="mb-2">
    <span class="tag"><%= room.type %></span>
    <span class="tag">Up to <%= room.capacity %> guests</span>
    <% if (typeof room.amenities !== 'undefined' && Array.isArray(room.amenities)) { room.amenities.slice(0, 3).forEach(a => { %><span class="tag"><%= a %></span><% }); } %>
  </div>
  <div class="flex">
    <a href="/rooms/<%= room.id %>" class="btn btn-primary">View details</a>
    <a href="/rooms/<%= room.id %>" class="btn" style="display:inline-flex;align-items:center;">Check availability</a>
  </div>
</div>
