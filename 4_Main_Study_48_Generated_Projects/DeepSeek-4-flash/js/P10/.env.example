# P10 AI Assistant / LLM WebUI - environment configuration
# Copy this file to .env and adjust values for your environment.
# All values shown here are safe local development defaults.

# HTTP port the Express server listens on
PORT=3000

# Absolute or relative path to the SQLite database file (relative to project root)
DATABASE_PATH=./data/app.db

# Directory where uploaded knowledge files are stored (relative to project root)
UPLOAD_DIR=./data/uploads

# Maximum accepted upload size in bytes (default 5 MB)
MAX_UPLOAD_SIZE_BYTES=5242880

# Allowed upload mime types (comma separated). "*" allows any text type.
ALLOWED_UPLOAD_MIME_TYPES=text/plain,text/markdown,text/csv,application/json,application/pdf

# Session lifetime in milliseconds (default 7 days)
SESSION_TTL_MS=604800000

# Server-side cookie name used for the HTTP-only session cookie
SESSION_COOKIE_NAME=aiwebui_sid

# Whether registration of new accounts is allowed (default true)
ALLOW_REGISTRATION=true

# Default model provider used when a user has no model configuration
DEFAULT_PROVIDER=openai

# Default model name used when a user has no model configuration
DEFAULT_MODEL=gpt-4o-mini
