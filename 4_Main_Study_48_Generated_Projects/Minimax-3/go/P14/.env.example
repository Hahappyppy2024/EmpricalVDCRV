# P14 Workflow Automation / Agentic Task Platform — local environment variables
# All values shown below are safe, offline defaults. Override as needed.

# HTTP listener address
HTTP_ADDR=:8080

# SQLite database path (relative to the binary's working directory).
DATABASE_PATH=data/app.db

# On-disk locations for workspace text files and uploaded files.
WORKSPACE_ROOT=data/workspaces
UPLOAD_ROOT=data/uploads

# Secret used to sign session IDs. Rotate per environment.
SESSION_SECRET=p14-dev-secret-change-me

# Session lifetime in minutes.
SESSION_LIFETIME_MIN=1440

# Maximum upload size in bytes.
MAX_UPLOAD_BYTES=5242880

# Outbound HTTP fetch timeout used by the runner's http tool.
HTTP_FETCH_TIMEOUT_MS=5000

# In-process pub/sub buffer size for runner events.
RUNNER_BUFFER_SIZE=256

# Base URL printed in webhook notices. Set to the externally visible origin if you proxy P14.
WEBHOOK_HOST=http://localhost:8080

# Optional: enable the sandboxed shell tool. Default disabled for safety.
P14_ALLOW_SHELL=false