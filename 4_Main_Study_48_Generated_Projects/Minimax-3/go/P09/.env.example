# Database and persistent storage
APP_DATA_DIR=data
APP_DB_PATH=data/its.db
APP_UPLOAD_DIR=data/uploads

# HTTP server
APP_ADDR=:8080
APP_BASE_URL=http://localhost:8080

# Sessions (do not change in production)
APP_COOKIE_NAME=its_session
APP_SESSION_KEY=please-change-this-in-production

# Optional: skip automatic seed on startup (APP_SKIP_SEED=1)