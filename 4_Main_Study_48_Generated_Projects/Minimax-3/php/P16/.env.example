APP_ENV=local
APP_NAME=P16-Server-Monitoring-Job-Control-Panel
APP_DEBUG=1
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

# SQLite database file (relative path resolved from project root)
DB_PATH=data/app.sqlite
DB_RESET_ON_BOOT=0

# Sessions
SESSION_COOKIE=p16_session
SESSION_LIFETIME_MINUTES=120

# Filesystem storage for uploads/backups
STORAGE_PATH=data/storage

# Default seed credentials (deterministic fixtures)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin#12345
SEED_OPERATOR_USERNAME=operator
SEED_OPERATOR_PASSWORD=Operator#12345

# Real-time (not used in this Slim-only build)
REALTIME_DRIVER=http