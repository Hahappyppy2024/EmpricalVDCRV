{
    "name": "p02/conference-review-system",
    "description": "P02 Conference Review System - Slim 4 + SQLite",
    "type": "project",
    "require": {
        "php": "^8.3",
        "slim/slim": "4.13.0",
        "slim/psr7": "1.6.1",
        "php-di/php-di": "7.0.7",
        "vlucas/phpdotenv": "5.6.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "audit": {
            "abandoned": "ignore"
        }
    },
    "minimum-stability": "stable"
}
