{
    "name": "mail-server-admin-console/app",
    "description": "P13 Mail Server / Admin Console (Slim 4 + SQLite + PHP 8.3)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "monolog/monolog": "3.5.0",
        "php-di/php-di": "7.0.5",
        "slim/php-view": "3.4.0",
        "slim/psr7": "1.6.1",
        "slim/slim": "4.13.0",
        "vlucas/phpdotenv": "5.6.1"
    },
    "autoload": {
        "psr-4": {
            "MailServer\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "audit": {
            "abandoned": "ignore"
        },
        "allow-plugins": {
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
