# Local application configuration
# Copy to `.env` to override defaults.

APP_ENV=local
APP_DEBUG=true

# Path to the SQLite database file (relative to the project root by default).
APP_DB_PATH=storage/app.db

# Where uploaded attachments are stored.
APP_UPLOAD_DIR=storage/uploads

# Where generated exports (CSV) are stored.
APP_EXPORT_DIR=storage/exports

# Optional: bind host and port for `composer serve`.
APP_HOST=127.0.0.1
APP_PORT=8080

# Session cookie name (do not change unless you know why).
APP_SESSION_NAME=MSAC_SID
