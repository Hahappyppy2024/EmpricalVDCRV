# Application
APP_ENV=local
APP_DEBUG=true
APP_NAME="Hosting Control Panel"

# HTTP
APP_URL=http://localhost:8080

# SQLite database (absolute path recommended)
DB_PATH=storage/data/panel.sqlite

# File storage
UPLOAD_DIR=storage/uploads
BACKUP_DIR=storage/backups

# Session
SESSION_NAME=panel_session
SESSION_LIFETIME=86400

# Deterministic secret for cookie signing (HMAC)
APP_SECRET=please-change-me-in-production