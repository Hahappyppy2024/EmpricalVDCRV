{
    "name": "minimax/p11-hosting-control-panel",
    "description": "P11 Hosting Control Panel (Slim 4 + SQLite)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-json": "*",
        "slim/slim": "^4.13",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.5",
        "respect/validation": "^2.3"
    },
    "config": {
        "sort-packages": true,
        "audit": {
            "abandoned": "ignore"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "init-db": "php bin/init-db.php",
        "serve": "php -S 0.0.0.0:8080 -t public public/index.php"
    },
    "config": {
        "sort-packages": true
    }
}