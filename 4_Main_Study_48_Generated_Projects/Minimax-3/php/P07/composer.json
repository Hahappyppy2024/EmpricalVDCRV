{
    "name": "emse/p07-cloud-file-sharing-system",
    "description": "P07 Cloud File-Sharing System built with Slim 4 and SQLite",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3.0",
        "slim/slim": "4.14.0",
        "slim/psr7": "1.7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "platform-check": false,
        "sort-packages": true,
        "audit": {
            "abandoned": "ignore"
        },
        "policy": {
            "advisories": {
                "ignore": [
                    "PKSA-ftt4-t9sz-mwn5"
                ]
            }
        }
    },
    "scripts": {
        "start": "php -S 127.0.0.1:8080 -t public public/router.php",
        "db:reset": "php bin/reset-db.php",
        "serve": "php -S 127.0.0.1:8080 -t public public/router.php"
    }
}