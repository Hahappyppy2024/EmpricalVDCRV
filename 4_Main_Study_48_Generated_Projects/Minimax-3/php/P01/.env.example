# P01 Learning Management System - environment template
# Copy this file to `.env` before running the app.

APP_ENV=local
APP_NAME="P01 LMS"
APP_DEBUG=true
APP_BASE_URL=http://localhost:8080

# SQLite database (relative path is resolved against the project root)
DB_PATH=storage/lms.sqlite

# Storage directories
UPLOAD_DIR=storage/uploads
EXPORT_DIR=storage/exports

# Session
SESSION_LIFETIME_SECONDS=7200
SESSION_COOKIE_NAME=lms_session

# Local WebSocket (Workerman) endpoint used when a browser wants live updates.
# Real-time transport is optional; the app stays functional on plain HTTP.
WS_HOST=127.0.0.1
WS_PORT=8282

# Deterministic local adapters (no third-party calls)
EMAIL_TRANSPORT=log
PAYMENT_TRANSPORT=stub
OBJECT_STORAGE=local
MODEL_PROVIDER=deterministic
