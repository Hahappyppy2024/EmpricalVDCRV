# AI Assistant / LLM WebUI configuration

# HTTP server
PORT=3000
HOST=127.0.0.1

# Session cookie name (HTTP-only)
SESSION_COOKIE_NAME=aiassist_sid
# Session lifetime in seconds (default 12 hours)
SESSION_LIFETIME_SECONDS=43200

# SQLite database file path (relative to project root)
DB_PATH=data/app.db

# File upload storage directory (relative to project root)
UPLOAD_DIR=data/uploads

# Maximum knowledge file size in bytes (5 MiB)
MAX_UPLOAD_BYTES=5242880

# Allowed knowledge file extensions (comma separated)
ALLOWED_UPLOAD_EXT=.txt,.md,.markdown,.csv,.json,.log

# Deterministic local model identifier
DEFAULT_MODEL_ID=local-bench-1
# Default model temperature
DEFAULT_TEMPERATURE=0.2
# Default context length (tokens)
DEFAULT_CONTEXT_LENGTH=2048

# Allowed origins for the public share viewer (comma separated, empty = any)
SHARE_ALLOWED_ORIGINS=

# Node environment
NODE_ENV=development
