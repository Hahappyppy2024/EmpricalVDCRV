# Data Analytics Dashboard (P12) - Environment variables
# Copy this file to `.env` and adjust values for the local environment.

# Secret key for Flask session cookie signing. Override in production.
SECRET_KEY=change-me-to-a-long-random-string

# SQLite database URI (relative paths are resolved against the project root).
DATABASE_URI=sqlite:///data/app.db

# Maximum upload size in bytes (default 25 MiB).
MAX_CONTENT_LENGTH=26214400

# Address and port for the local Flask development server.
HOST=127.0.0.1
PORT=5000

# Toggle the Flask debugger (set to 0 in production).
FLASK_DEBUG=1

# Default retention days for stored datasets (DATA-12 admin operation).
DATASET_RETENTION_DAYS=90

# Default maximum datasets a single user may own.
MAX_DATASETS_PER_USER=25

# Toggle to expose the mock data source registry to all signed-in roles.
EXPOSE_DATA_SOURCES_TO_VIEWERS=0
