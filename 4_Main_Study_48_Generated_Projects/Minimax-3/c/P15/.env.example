# .env.example — environment variables consumed by docker-compose and the
# multi-stage Dockerfile. These values are substituted into container paths
# and do NOT replace the structured netd.conf parser inside the daemon.

# Host bind address for the published TCP listener
NETD_BIND_ADDRESS=127.0.0.1

# Host TCP listener port
NETD_PORT=9090

# Path inside the container for the SQLite database file
NETD_DATABASE_PATH=/var/lib/netd/netd.db

# Path inside the container for the structured log file
NETD_LOG_PATH=/var/log/netd/netd.log

# Path inside the container for the audit log file
NETD_AUDIT_LOG_PATH=/var/log/netd/netd.audit.log

# Path inside the container for the PID file
NETD_PID_FILE=/var/run/netd/netd.pid

# Number of worker threads
NETD_WORKER_COUNT=4

# Maximum concurrent clients
NETD_MAX_CLIENTS=64

# Idle timeout in seconds
NETD_IDLE_TIMEOUT_SECONDS=60